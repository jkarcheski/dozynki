# Copy to .env (git-ignored) and fill in. Never commit real credentials.

# Babamul (https://babamul.caltech.edu/signup). Optional: without a token the
# Babamul panel is simply skipped.
BABAMUL_API_TOKEN=
BABAMUL_KAFKA_USERNAME=
BABAMUL_KAFKA_PASSWORD=

# Name recorded with each label (handle or initials).
DOZYNKI_LABELER=

# Shared server: profiles and guests (see README "Profiles"). Off on a laptop.
DOZYNKI_ACCOUNTS=0
DOZYNKI_SECURE_COOKIES=0
# Base address for password-reset links, e.g. https://dozynki.example.edu (default: the request's own)
DOZYNKI_BASE_URL=
# Mail server for password resets; without a host the link is printed in the server log.
DOZYNKI_SMTP_HOST=
DOZYNKI_SMTP_PORT=587
DOZYNKI_SMTP_USER=
DOZYNKI_SMTP_PASSWORD=
DOZYNKI_SMTP_FROM=

# Hide broker classifications / ML scores until a blind label is committed.
DOZYNKI_BLIND=1
